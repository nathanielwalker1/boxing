{
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write(scripts/**)",
      "Write(src/**)",
      "Write(docs/**)",
      "Write(tools/**)",

      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",

      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(ls:*)",
      "Bash(find:*)",
      "Bash(wc:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(file:*)",
      "Bash(which:*)",
      "Bash(open:*)",
      "Bash(sips:*)",
      "Bash(mkdir:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git branch:*)",
      "Bash(git stash:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git commit:*)",
      "Bash(git merge:*)",
      "Bash(git worktree:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",

      "Bash(ln -s:*)",
      "Bash(cat:*)",
      "Bash(node_modules/.bin/vite:*)",
      "Bash(node_modules/.bin/tsc:*)",
      "Bash(TEST_NO_REUSE=1 npm:*)",
      "Bash(TEST_NO_REUSE=1 node:*)",
      "Bash(PORT=5190 node:*)",
      "Bash(PORT=5191 node:*)",
      "Bash(PORT=5192 node:*)",
      "Bash(PORT=5193 node:*)",
      "Bash(PORT=5194 node:*)",
      "Bash(PORT=5195 node:*)",
      "Bash(PORT=5196 node:*)",
      "Bash(PORT=5190 npm:*)",
      "Bash(PORT=5195 npm:*)",
      "Bash(PORT=5196 npm:*)",
      "Bash(PORT=5191 npm:*)",
      "Bash(PORT=5192 npm:*)",
      "Bash(PORT=5193 npm:*)",
      "Bash(PORT=5194 npm:*)",

      "Bash(lsof:*)",
      "Bash(ps:*)",
      "Bash(pkill:*)",
      "Bash(kill:*)",
      "Bash(curl -s http://localhost:*)",
      "Bash(curl -s -o /dev/null:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(sed -i:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
